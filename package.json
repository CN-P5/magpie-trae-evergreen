{
  "name": "magpie-trae-evergreen",
  "version": "0.4.0",
  "description": "Magpie models in Trae CN on Windows. Resolves any client build by credential layout and a catalog self-check instead of a version allowlist.",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "trae.agent.js",
    "index.mjs",
    "identity.mjs",
    "bridge.mjs",
    "cli.mjs",
    "README.md",
    "LICENSE",
    "assets",
    "ASSET_NOTICE.md",
    "sync.mjs",
    "trae-api.mjs",
    "trae-local-token.mjs",
    "trae-install.mjs",
    "restore.mjs",
    "client-refresh.mjs",
    "trae-refresh-notifier.cjs",
    "vendor",
    "THIRD_PARTY.md",
    "README.en.md"
  ],
  "bin": {
    "magpie-trae-evergreen": "./cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "acceptance": "node scripts/magpie-acceptance.mjs",
    "test:cancel": "node scripts/verify-trae-cancel-patch.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "magpie": {
    "agent": "./trae.agent.js",
    "icon": "data:image/svg+xml;base64,",
    "options": {
      "port": 3499
    },
    "name": "Trae CN · Evergreen"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CN-P5/magpie-trae-evergreen.git"
  },
  "homepage": "https://github.com/CN-P5/magpie-trae-evergreen#readme",
  "bugs": {
    "url": "https://github.com/CN-P5/magpie-trae-evergreen/issues"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-agent",
    "trae",
    "trae-cn",
    "evergreen",
    "build-agnostic",
    "windows"
  ]
}
